# ============================================
# VR Therapy MVP — Ortam Değişkenleri
# ============================================

# --- OpenAI (Sahne Planlama) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- ComfyUI (Panorama Üretimi) ---
COMFYUI_API_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=/data/panoramas

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Media Service ---
MEDIA_SERVICE_PORT=3001
MEDIA_OUTPUT_DIR=/data/videos
MEDIA_TEMP_DIR=/data/temp
PANORAMA_INPUT_DIR=/data/panoramas

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/vr-therapy

# --- E-posta (opsiyonel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vrtherapy.local

# --- Genel ---
PUBLIC_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vrtherapy.local
